{
  "name": "@examples/express-mongoose",
  "private": true,
  "type": "module",
  "description": "keyset-kit example: Express 5 + Mongoose 9 + MongoDB",
  "scripts": {
    "start": "docker compose up -d --wait && pnpm serve",
